# Schedule AI Voice - example environment file.
# Copy to `.env` and fill in locally. NEVER commit a real .env or a real secret.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Prisma datasource URL. This mission uses a file-based SQLite database so a
# fresh clone needs no external credentials and no network access.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# OpenAI API key used by the agent layer's LlmProvider adapter.
# Leave EMPTY here. Set it only in your local, git-ignored .env file.
# The foundation, scheduling and test suites never require this to be set:
# every test runs against deterministic doubles.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Local LLM (Ollama) - Mission 2, the local brain
# ---------------------------------------------------------------------------
# Which LlmProvider a composed runtime should use: scripted | local | openai.
#
# DEFAULTS TO `scripted`, and leaving it that way is the safe choice: the
# scripted provider talks to nobody and spends nothing. Setting this to `local`
# states an INTENT - it does not by itself make anything dial a model, because
# `buildAgentRuntime` still requires a caller to pass `llmProviderConfig`
# explicitly. That is deliberate; see src/app/composition.ts.
LLM_PROVIDER=scripted

# Base URL of the Ollama server. NOTE: inside a container, `localhost` is the
# container - use host.docker.internal to reach the host's Ollama. This is the
# single most common misconfiguration. Run `npm run llm:probe` to check.
LOCAL_LLM_BASE_URL="http://host.docker.internal:11434"

# The Ollama model tag to use. Must already be present on the host; pull it with
#   curl http://<host>:11434/api/pull -d '{"model":"qwen2.5:7b-instruct"}'
# `npm run llm:probe` lists what is present and flags an absent one.
LOCAL_LLM_MODEL="qwen2.5:7b-instruct"

# Sampling temperature, 0-2. Zero by default: this agent follows a guardrailed
# procedure and calls tools, it is not being creative about when it phones
# someone.
LOCAL_LLM_TEMPERATURE=0

# Nucleus sampling (top_p), 0-1. Leave EMPTY to use the model's own default.
LOCAL_LLM_TOP_P=

# Context window (Ollama's num_ctx).
#
# 8192, not 4096, and the reason is measured: the production system prompt plus
# all nine tool schemas costs 3,732 prompt tokens before the conversation even
# starts. Ollama does not error on an over-long prompt, it silently truncates
# from the FRONT - which is where the guardrail clauses live. Headroom here is a
# safety property, not a comfort. Costs ~0.22 GiB of VRAM over 4096 on an
# RTX 4060 Laptop; 16384 costs ~0.67 GiB over 4096 and is a fine choice for
# longer calls.
LOCAL_LLM_NUM_CTX=8192

# Hard per-request deadline in milliseconds, 1000-600000. Generous by default: a
# cold 7B model load costs 2-4 seconds on this hardware before the first token.
LOCAL_LLM_TIMEOUT_MS=120000

# How long Ollama keeps the model resident after a request ("5m", "0", "-1" for
# forever). Keeping it loaded turns a 4.9s first turn into a 0.9s one.
LOCAL_LLM_KEEP_ALIVE="5m"

# ---------------------------------------------------------------------------
# Application policy
# ---------------------------------------------------------------------------
# IANA timezone used when neither the contact nor the agent configuration
# supplies one. Must be a valid IANA zone name (not a UTC offset).
APP_TIMEZONE_DEFAULT="America/New_York"
